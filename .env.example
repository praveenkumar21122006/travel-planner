DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_planner?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Used only by the local Express server; Vercel supplies its own port.
PORT=3001
OPENWEATHER_API_KEY="replace-with-openweathermap-api-key"
AMADEUS_API_KEY="replace-with-amadeus-api-key"
AMADEUS_API_SECRET="replace-with-amadeus-api-secret"
GEONAMES_USERNAME="replace-with-geonames-username"
